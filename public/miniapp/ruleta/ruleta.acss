page {
  background: #F5F6FA;
  height: 100vh;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}

/* ── CONTENEDOR PRINCIPAL: columna que ocupa exactamente la pantalla ── */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 0;
}

/* HEADER — padding compacto para ceder espacio a la ruleta */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  padding: 40rpx 32rpx 38rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.title-row { display: flex; align-items: center; gap: 20rpx; }
.back-btn {
  font-size: 38rpx;
  color: #FFFFFF;
  background: rgba(255,255,255,0.15);
  border-radius: 18rpx;
  padding: 10rpx 20rpx;
}
.title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* ── GAME BOARD: flex:1 toma todo el espacio disponible entre header y controls ── */
.game-board {
  flex: 1;
  min-height: 0;           /* permite que flex-item se encoja */
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin: 16rpx 24rpx 12rpx;
  border: 1.5rpx solid #E6E6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* ── SLOT CONTAINER: se ajusta al game-board ── */
.slot-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

/* ── BORDE METÁLICO CON EFECTO CURVATURA ──
   Gradiente vertical: oscuro en extremos → azul metálico al centro,
   simula que el borde se curva hacia afuera como un cilindro.          */
.slot-border {
  border-radius: 28rpx;
  padding: 18rpx;
  background: linear-gradient(
    to bottom,
    #040c18 0%,
    #0a1f3d 12%,
    #133972 28%,
    #1b52a0 42%,
    #2060b8 50%,
    #1b52a0 58%,
    #133972 72%,
    #0a1f3d 88%,
    #040c18 100%
  );
  box-shadow:
    0 0 0 3rpx #03070d,
    0 0 60rpx rgba(20, 55, 120, 0.55),
    0 12rpx 44rpx rgba(0, 0, 0, 0.65);
  /* Altura máxima relativa al game-board para que nunca desborde */
  max-height: 100%;
  display: flex;
}

.slot-machine {
  position: relative;
  width: 340rpx;
  /* 3 símbolos × 240rpx = 720rpx → centro exacto en 360rpx */
  height: 720rpx;
  background: #1A1A2E;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: inset 0 3rpx 8rpx rgba(110, 170, 255, 0.15);
}

.reel-wrapper { width: 100%; height: 100%; overflow: hidden; position: relative; }
.reel { display: flex; flex-direction: column; }
.reel.spinning { transition: transform 5s cubic-bezier(0.05, 0.9, 0.1, 1); }

/* Símbolo: 240rpx de alto → 3 caben exactos en la ventana de 720rpx */
.reel-symbol {
  width: 340rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 3rpx solid rgba(255,255,255,0.05);
  box-sizing: border-box;
}
.sym-text { font-size: 40rpx; font-weight: 900; color: #fff; }

/* Fundidos superior e inferior (reducidos para no ocultar demasiado) */
.slot-overlay {
  position: absolute;
  left: 0; right: 0;
  height: 40rpx;
  z-index: 5;
  pointer-events: none;
}
.slot-overlay.top    { top: 0;    background: linear-gradient(to bottom, rgba(26,26,46,0.7), transparent); }
.slot-overlay.bottom { bottom: 0; background: linear-gradient(to top,   rgba(26,26,46,0.7), transparent); }

/* Indicadores triangulares (30% más grandes que original) */
.slot-line {
  position: absolute;
  top: 50%;
  left: -14rpx; right: -14rpx;
  height: 0;
  transform: translateY(-50%);
  z-index: 10;
}
.slot-line::before, .slot-line::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 0; height: 0;
  transform: translateY(-50%);
  border-top: 26rpx solid transparent;
  border-bottom: 26rpx solid transparent;
}
.slot-line::before {
  left: 0;
  border-right: 39rpx solid #4F6BEB;
  transform: translateY(-50%) rotate(180deg);
  filter: drop-shadow(0 0 10rpx #4F6BEB);
}
.slot-line::after {
  right: 0;
  border-left: 39rpx solid #4F6BEB;
  transform: translateY(-50%) rotate(180deg);
  filter: drop-shadow(0 0 10rpx #4F6BEB);
}

/* ── CONTROLS ── */
.controls {
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 20rpx 28rpx;
  margin: 0 24rpx 20rpx;
  border: 1.5rpx solid #E6E6EB;
  flex-shrink: 0;
}

.spin-btn {
  background: #1736C8;
  border-radius: 18rpx;
  padding: 26rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.spin-btn.disabled { background: #F3F3F6; }
.spin-btn.disabled .spin-text { color: #B8B8C2; }
.spin-icon { font-size: 36rpx; }
.spin-text { font-size: 30rpx; font-weight: 600; color: #FFFFFF; }
.spin-btn-shadow { display: none; }
.spin-btn-front  { display: flex; align-items: center; gap: 16rpx; }

/* WIN POPUP */
.win-popup {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0);
  width: 480rpx;
  height: 140rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  opacity: 0;
  transition: all 0.3s ease;
  box-shadow: 0 0 50rpx rgba(0,0,0,0.3), 0 0 80rpx rgba(23,54,200,0.2);
  border: 3rpx solid rgba(255,255,255,0.25);
}
.win-popup.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  animation: winPulse 0.6s ease infinite;
}
.win-text {
  font-size: 64rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
  white-space: nowrap;
}
@keyframes winPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50%       { transform: translate(-50%, -50%) scale(1.08); }
}

/* ANIMACIONES */
.spin-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #1A1A2E;
  align-items: center;
  justify-content: center;
  z-index: 15;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.spin-overlay.show { opacity: 1; animation: spinFade 2.5s ease infinite; }
@keyframes spinFade { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-2rpx); } 75% { transform: translateX(2rpx); } }
.reel.blur { filter: blur(4rpx); animation: shake 0.1s infinite; }
