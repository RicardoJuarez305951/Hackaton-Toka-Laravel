page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { padding: 0 0 40rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.title-row { display: flex; align-items: center; gap: 20rpx; }
.back-btn {
  font-size: 38rpx;
  color: #FFFFFF;
  background: rgba(255,255,255,0.15);
  border-radius: 18rpx;
  padding: 10rpx 20rpx;
}
.title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* GAME AREA */
.game-area {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 28rpx 24rpx;
  border: 1.5rpx solid #E6E6EB;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* STREAK BAR */
.streak-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
  background: #F5F6FA;
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  border: 1.5rpx solid #E6E6EB;
  width: 100%;
  box-sizing: border-box;
}
.streak-label { font-size: 22rpx; color: #B8B8C2; text-transform: uppercase; letter-spacing: 2rpx; font-weight: 600; }
.streak-dots { display: flex; gap: 8rpx; flex: 1; }
.streak-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #E6E6EB; }
.streak-dot.filled { background: #1736C8; }
.streak-count { font-size: 28rpx; font-weight: 800; color: #1736C8; }

/* CARD */
.card-area { margin-bottom: 30rpx; }
.playing-card {
  width: 300rpx;
  height: 420rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #E6E6EB;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.3s ease;
}
.playing-card.flip { animation: cardFlip 0.8s ease; }
@keyframes cardFlip {
  0%   { transform: rotateY(0deg) scale(1); }
  50%  { transform: rotateY(90deg) scale(0.9); }
  100% { transform: rotateY(0deg) scale(1); }
}
.playing-card.red .card-rank,
.playing-card.red .card-suit-big { color: #D96A7C; }
.playing-card.black .card-rank,
.playing-card.black .card-suit-big { color: #1A1A2E; }
.card-rank { font-size: 40rpx; font-weight: 900; position: absolute; }
.card-rank.top { top: 20rpx; left: 24rpx; }
.card-rank.bottom { bottom: 20rpx; right: 24rpx; transform: rotate(180deg); }
.card-suit-big { font-size: 120rpx; line-height: 120rpx; }

/* Placeholder */
.card-placeholder {
  width: 300rpx;
  height: 420rpx;
  background: #F5F6FA;
  border-radius: 20rpx;
  border: 2rpx dashed #E6E6EB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.placeholder-text { font-size: 80rpx; }
.placeholder-hint { font-size: 24rpx; color: #B8B8C2; }

/* MULTIPLIER PANEL */
.multiplier-panel {
  width: 100%;
  background: #F5F6FA;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  border: 1.5rpx solid #E6E6EB;
  box-sizing: border-box;
}
.mult-row { display: flex; justify-content: space-between; align-items: center; }
.mult-row.sub { margin-top: 8rpx; }
.mult-label { font-size: 24rpx; color: #4A4A4A; }
.mult-value { font-size: 32rpx; font-weight: 800; color: #1736C8; }
.mult-row.sub .mult-value { font-size: 26rpx; color: #B8B8C2; }

/* ACTION BUTTONS */
.actions { display: flex; gap: 16rpx; margin: 0 28rpx 24rpx; align-items: stretch; }
.guess-btn {
  flex: 1;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.guess-btn.higher { background: #22C97B; }
.guess-btn.lower  { background: #D96A7C; }
.guess-btn.disabled { background: #F3F3F6; }
.guess-btn.disabled .guess-arrow,
.guess-btn.disabled .guess-label { color: #B8B8C2; }
.guess-arrow { font-size: 36rpx; font-weight: 900; color: #fff; }
.guess-label { font-size: 22rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }
.guess-mult {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  background: rgba(0,0,0,0.15);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.cashout-btn {
  flex: 1;
  background: #1736C8;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.cashout-btn.disabled { background: #F3F3F6; }
.cashout-btn.disabled .cashout-amount,
.cashout-btn.disabled .cashout-label { color: #B8B8C2; }
.cashout-amount { font-size: 28rpx; font-weight: 900; color: #fff; }
.cashout-label { font-size: 20rpx; font-weight: 700; color: rgba(255,255,255,0.8); letter-spacing: 2rpx; }

/* CONTROLS / START */
.controls { padding: 0 28rpx; margin-bottom: 24rpx; }
.start-btn {
  background: #1736C8;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
}
.start-text { font-size: 30rpx; font-weight: 600; color: #FFFFFF; }

/* RESULT PANEL */
.result-panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1.5rpx solid #E6E6EB;
  padding: 28rpx 32rpx;
  margin-top: 20rpx;
  display: none;
  align-items: center;
  gap: 20rpx;
}
.result-panel.show { display: flex; }
.result-emoji { font-size: 48rpx; }
.result-msg { font-size: 32rpx; font-weight: 700; }
.result-msg.win  { color: #22C97B; }
.result-msg.lose { color: #D96A7C; }
