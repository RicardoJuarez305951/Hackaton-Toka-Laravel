page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { padding: 0 0 40rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.title-row { display: flex; align-items: center; gap: 20rpx; }
.back-btn {
  font-size: 38rpx;
  color: #FFFFFF;
  font-weight: 500;
  background: rgba(255,255,255,0.15);
  border-radius: 18rpx;
  padding: 10rpx 20rpx;
}
.title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* GAME BOARD */
.game-board {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin: 0 28rpx 24rpx;
  border: 1.5rpx solid #E6E6EB;
}

/* Board container */
.plinko-container {
  width: 650rpx;
  height: 650rpx;
  margin: 0 auto 20rpx;
  position: relative;
  background: #1A1A2E;
  border-radius: 20rpx;
  border: 1.5rpx solid #E6E6EB;
  overflow: hidden;
}

/* Peg pyramid */
.plinko-pyramid {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}
.plinko-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 66rpx;
  height: 80rpx;
  width: 100%;
}

/* Pegs */
.peg {
  width: 20rpx;
  height: 20rpx;
  background: radial-gradient(circle at 35% 35%, #fff 0%, #ccc 50%, #888 100%);
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(255,255,255,0.6), 0 2rpx 6rpx rgba(0,0,0,0.4);
  transition: transform 0.25s ease-out, box-shadow 0.25s ease-out, background 0.25s ease-out;
}
.peg.hit {
  background: radial-gradient(circle at 35% 35%, #ffffff 0%, #4F6BEB 40%, #1736C8 100%);
  transform: scale(1.9);
  box-shadow:
    0 0 0rpx 6rpx rgba(23,54,200,0.35),
    0 0 28rpx 8rpx rgba(79,107,235,0.6),
    0 0 50rpx 12rpx rgba(23,54,200,0.3);
  transition: transform 0.08s ease-out, box-shadow 0.08s ease-out, background 0.08s ease-out;
}

/* Prize slots */
.slots-row {
  position: absolute;
  bottom: 20rpx;
  left: 10rpx;
  right: 10rpx;
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}
.slot {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  box-sizing: border-box;
}
.slot.gold  { background: linear-gradient(180deg, #4F6BEB 0%, #1736C8 100%); }
.slot.blue  { background: linear-gradient(180deg, #4fc3f7 0%, #0288d1 100%); }
.slot.green { background: linear-gradient(180deg, #22C97B 0%, #15a863 100%); }
.slot.gray  { background: linear-gradient(180deg, #B8B8C2 0%, #8a8a96 100%); }
.slot.red   { background: linear-gradient(180deg, #D96A7C 0%, #b5495a 100%); }
.slot.purple{ background: linear-gradient(180deg, #ab47bc 0%, #7b1fa2 100%); }
.slot-multi { font-size: 22rpx; font-weight: 800; color: #fff; }

/* Ball */
.ball {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, #c9d4ff 0%, #4F6BEB 35%, #1736C8 65%, #0f2490 100%);
  box-shadow: 0 0 20rpx rgba(79,107,235,0.9), 0 0 40rpx rgba(23,54,200,0.4), 0 3rpx 6rpx rgba(0,0,0,0.5);
  z-index: 20;
  transform: translate(-50%, -50%) scale(1);
  transition:
    transform 0.1s ease-out,
    opacity 0.15s ease;
  opacity: 0;
  pointer-events: none;
}
.ball.visible { opacity: 1; }
.ball.bouncing {
  transform: translate(-50%, -50%) scaleX(1.15) scaleY(0.85); /* Squash slightly */
  transition:
    transform 0.08s ease-out,
    opacity 0.15s ease;
}

/* CONTROLS */
.controls { padding: 0 28rpx; margin-bottom: 24rpx; }
.play-btn {
  background: #1736C8;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
}
.play-btn.disabled { background: #F3F3F6; }
.play-btn.disabled .play-text { color: #B8B8C2; }
.play-text { font-size: 30rpx; font-weight: 600; color: #FFFFFF; letter-spacing: 0.5rpx; }

/* HISTORY */
.history-panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 28rpx;
  border: 1.5rpx solid #E6E6EB;
}
.history-title {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.history-list { display: flex; gap: 16rpx; }
.history-item {
  flex: 1;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border: 1.5rpx solid #E6E6EB;
}
.history-item.win { border-color: #22C97B; }
.history-item.lose { border-color: #D96A7C; }
.history-emoji { font-size: 32rpx; }
.history-amount { font-size: 24rpx; font-weight: 600; color: #1A1A2E; }
.history-item.win .history-amount { color: #22C97B; }
.history-item.lose .history-amount { color: #D96A7C; }
