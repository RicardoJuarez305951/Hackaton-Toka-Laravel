page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { padding-bottom: 120rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.title-row { display: flex; align-items: center; }
.title { font-size: 44rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* POINTS DISPLAY */
.points-display {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 28rpx 28rpx;
  text-align: center;
  border: 1.5rpx solid #E6E6EB;
}
.points-label { display: block; font-size: 26rpx; color: #4A4A4A; margin-bottom: 12rpx; font-weight: 600; }
.points-value { display: block; font-size: 64rpx; font-weight: 800; color: #1736C8; }

/* REWARDS */
.rewards-section { padding: 0 28rpx; margin-bottom: 28rpx; }
.section-title {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  font-weight: 600;
}
.rewards-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.reward-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  border: 1.5rpx solid #E6E6EB;
  box-sizing: border-box;
}
.reward-icon { display: block; font-size: 48rpx; margin-bottom: 12rpx; }
.reward-name { display: block; font-size: 26rpx; font-weight: 600; color: #1A1A2E; margin-bottom: 8rpx; }
.reward-cost { display: block; font-size: 28rpx; font-weight: 700; color: #1736C8; margin-bottom: 16rpx; }
.redeem-btn {
  background: #1736C8;
  border-radius: 12rpx;
  padding: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* HISTORY */
.history-section { padding: 0 28rpx; margin-bottom: 28rpx; }
.history-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  border: 1.5rpx solid #E6E6EB;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E6E6EB;
}
.history-item:last-child { border-bottom: none; }
.history-icon { font-size: 32rpx; }
.history-name { flex: 1; font-size: 26rpx; color: #1A1A2E; font-weight: 500; }
.history-date { font-size: 22rpx; color: #B8B8C2; }

/* NAVBAR */
.navbar {
  background: #FFFFFF;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  border-top: 1.5rpx solid #E6E6EB;
}
.nav-item { display: flex; flex-direction: column; align-items: center; padding: 8rpx 28rpx; }
.nav-item.active .nav-text { color: #1736C8; font-weight: 700; }
.nav-icon { font-size: 40rpx; margin-bottom: 6rpx; opacity: 0.5; }
.nav-item.active .nav-icon { opacity: 1; }
.nav-text { font-size: 22rpx; color: #B8B8C2; }
