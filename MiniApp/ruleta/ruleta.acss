page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { padding: 0 0 40rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.title-row { display: flex; align-items: center; gap: 20rpx; }
.back-btn {
  font-size: 38rpx;
  color: #FFFFFF;
  background: rgba(255,255,255,0.15);
  border-radius: 18rpx;
  padding: 10rpx 20rpx;
}
.title { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* GAME BOARD */
.game-board {
  background:white; /*linear-gradient(135deg, #252542 0%, #1e1e38 100%);*/
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 28rpx 24rpx;
  border: 1.5rpx solid #E6E6EB;
  display: flex;
  justify-content: center;
}
.slot-container {
  position: relative;
  width: 350rpx;
  height: 960rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.slot-machine {
  position: relative;
  width: 400rpx;
  height: 950rpx;
  background: #1A1A2E;
  border-radius: 20rpx;
  overflow: hidden;
  border: 6rpx solid #1736C8;
  box-shadow: 0 0 30rpx rgba(23,54,200,0.25);
}
.reel-wrapper { width: 100%; height: 100%; overflow: hidden; position: relative; }
.reel { display: flex; flex-direction: column; }
.reel.spinning { transition: transform 5s cubic-bezier(0.05, 0.9, 0.1, 1); }
.reel-symbol {
  width: 350rpx;
  height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 4rpx solid rgba(255,255,255,0.05);
  box-sizing: border-box;
}
.sym-text { font-size: 40rpx; font-weight: 900; color: #fff; }
.slot-overlay {
  position: absolute;
  left: 0; right: 0;
  height: 60rpx;
  z-index: 5;
  pointer-events: none;
}
.slot-overlay.top    { top: 0;    background: linear-gradient(to bottom, #1A1A2E, transparent); }
.slot-overlay.bottom { bottom: 0; background: linear-gradient(to top,   #1A1A2E, transparent); }
.slot-line {
  position: absolute;
  top: 50%;
  left: -10rpx; right: -10rpx;
  height: 0;
  transform: translateY(-50%);
  z-index: 10;
}
.slot-line::before, .slot-line::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 0; height: 0;
  transform: translateY(-50%);
  border-top: 40rpx solid transparent;
  border-bottom: 40rpx solid transparent;
}
.slot-line::before {
  left: 0;
  border-right: 30rpx solid #4F6BEB;
  filter: drop-shadow(0 0 10rpx #4F6BEB);
  transform: translateY(-50%) rotate(180deg);
  filter: drop-shadow(0 0 10rpx #ffd700);
}
.slot-line::after {
  right: 0;
  border-left: 30rpx solid #4F6BEB;
  filter: drop-shadow(0 0 10rpx #4F6BEB);
  transform: translateY(-50%) rotate(180deg);
  filter: drop-shadow(0 0 10rpx #ffd700);
}

/* CONTROLS */
.controls {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 0 28rpx 24rpx;
  border: 1.5rpx solid #E6E6EB;
}
.bet-control { margin-bottom: 24rpx; }
.control-label {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.bet-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.bet-btn {
  width: 70rpx; height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}
.bet-btn.minus { background: #D96A7C; color: #fff; }
.bet-btn.plus  { background: #22C97B; color: #fff; }
.bet-display {
  background: #F5F6FA;
  border-radius: 16rpx;
  padding: 16rpx 40rpx;
  border: 1.5rpx solid #E6E6EB;
}
.bet-amount { font-size: 36rpx; font-weight: 700; color: #1A1A2E; }
.bet-presets { display: flex; justify-content: center; gap: 16rpx; }
.preset-btn {
  background: #F3F3F6;
  color: #B8B8C2;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.preset-btn.active { background: #1736C8; color: #fff; }

.spin-btn {
  background: #1736C8;
  border-radius: 20rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.spin-btn.disabled { background: #F3F3F6; }
.spin-btn.disabled .spin-text { color: #B8B8C2; }
.spin-icon { font-size: 36rpx; }
.spin-text { font-size: 30rpx; font-weight: 600; color: #FFFFFF; }

/* RESULTS */
.results-panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 28rpx;
  border: 1.5rpx solid #E6E6EB;
}
.panel-title {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  font-weight: 600;
}
.results-grid { display: flex; gap: 16rpx; }
.result-item {
  flex: 1;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 1.5rpx solid #E6E6EB;
}
.result-item.win  { border-color: #22C97B; }
.result-item.lose { border-color: #D96A7C; }
.result-emoji { font-size: 28rpx; }
.result-profit { font-size: 24rpx; font-weight: 600; color: #1A1A2E; }
.result-item.win .result-profit  { color: #22C97B; }
.result-item.lose .result-profit { color: #D96A7C; }

/* WIN POPUP */
.win-popup {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0);
  width: 560rpx;
  height: 160rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
  opacity: 0;
  transition: all 0.3s ease;
  box-shadow: 0 0 50rpx rgba(0,0,0,0.3), 0 0 80rpx rgba(23,54,200,0.2);
  border: 3rpx solid rgba(255,255,255,0.25);
}
.win-popup.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  animation: winPulse 0.6s ease infinite;
}
.win-text {
  font-size: 72rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
  white-space: nowrap;
}
@keyframes winPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); }
  50%       { transform: translate(-50%, -50%) scale(1.08); }
}

/* ANIMATIONS */
.spin-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #1A1A2E;
  align-items: center;
  justify-content: center;
  z-index: 15;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
.spin-overlay.show { opacity: 1; animation: spinFade 2.5s ease infinite; }
.spin-overlay .spin-text { font-size: 80rpx; animation: spinIcon 0.3s linear infinite; }
@keyframes spinIcon { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@keyframes spinFade { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-2rpx); } 75% { transform: translateX(2rpx); } }
.reel.blur { filter: blur(4rpx); animation: shake 0.1s infinite; }
