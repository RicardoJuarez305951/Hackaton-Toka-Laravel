page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { display: flex; flex-direction: column; min-height: 100vh; }
.content { flex: 1; padding-bottom: 120rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 56rpx;
  margin-bottom: 32rpx;
}
.logo-area { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.logo { font-size: 44rpx; }
.title { font-size: 48rpx; font-weight: 700; color: #FFFFFF; }
.subtitle { display: block; font-size: 26rpx; color: rgba(255,255,255,0.7); }

/* BALANCE CARD */
.balance-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 28rpx 28rpx;
  border: 1.5rpx solid #E6E6EB;
}
.balance-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.balance-label { font-size: 24rpx; color: #4A4A4A; font-weight: 600; }
.balance-icon { font-size: 32rpx; }
.balance-amount { display: block; font-size: 56rpx; font-weight: 800; color: #1736C8; margin-bottom: 24rpx; }
.balance-actions { display: flex; gap: 16rpx; }
.action-btn {
  flex: 1;
  background: rgba(23,54,200,0.07);
  border-radius: 16rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(23,54,200,0.15);
}
.action-icon { font-size: 28rpx; }
.action-text { font-size: 26rpx; color: #1736C8; font-weight: 600; }

/* QUICK PLAY */
.quick-play { padding: 0 28rpx; margin-bottom: 28rpx; }
.section-title {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  font-weight: 600;
}
.play-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1.5rpx solid #E6E6EB;
}
.play-info { flex: 1; }
.play-name { display: block; font-size: 32rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 6rpx; }
.play-desc { display: block; font-size: 24rpx; color: #4A4A4A; }
.play-btn-small {
  background: #1736C8;
  border-radius: 14rpx;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* STATS GRID */
.stats-grid { padding: 0 28rpx; display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.stat-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  border: 1.5rpx solid #E6E6EB;
}
.stat-box.win { border-color: #22C97B; }
.stat-value { display: block; font-size: 34rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 8rpx; }
.stat-box.win .stat-value { color: #22C97B; }
.stat-label { display: block; font-size: 20rpx; color: #B8B8C2; }

/* NAVBAR */
.navbar {
  background: #FFFFFF;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  border-top: 1.5rpx solid #E6E6EB;
}
.nav-item { display: flex; flex-direction: column; align-items: center; padding: 8rpx 28rpx; }
.nav-item.active .nav-text { color: #1736C8; font-weight: 700; }
.nav-icon { font-size: 40rpx; margin-bottom: 6rpx; opacity: 0.5; }
.nav-item.active .nav-icon { opacity: 1; }
.nav-text { font-size: 22rpx; color: #B8B8C2; }
