page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { padding-bottom: 120rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.title-row { display: flex; align-items: center; }
.title { font-size: 44rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* GAMES LIST */
.games-section { padding: 0 28rpx; margin-bottom: 32rpx; }
.section-title {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  font-weight: 600;
}
.games-list { display: flex; flex-direction: column; gap: 16rpx; }
.game-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  border: 1.5rpx solid #E6E6EB;
}
.game-card:active { background: #F5F6FA; }
.game-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.game-icon-wrapper.plinko    { background: rgba(23,54,200,0.10); }
.game-icon-wrapper.rasca     { background: rgba(34,201,123,0.12); }
.game-icon-wrapper.ruleta    { background: rgba(217,106,124,0.12); }
.game-icon-wrapper.hilo      { background: rgba(79,107,235,0.10); }
.game-icon-wrapper.goldentree{ background: rgba(251,188,5,0.12); }
.game-icon { font-size: 44rpx; }
.game-info { flex: 1; }
.game-name { display: block; font-size: 30rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 6rpx; }
.game-desc { display: block; font-size: 24rpx; color: #4A4A4A; }
.game-arrow { font-size: 28rpx; color: #1736C8; font-weight: 700; }

/* STATS */
.stats-summary { padding: 0 28rpx; display: flex; gap: 16rpx; margin-bottom: 32rpx; }
.stat-box {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  border: 1.5rpx solid #E6E6EB;
}
.stat-box.win { border-color: #22C97B; }
.stat-icon { display: block; font-size: 32rpx; margin-bottom: 8rpx; }
.stat-value { display: block; font-size: 30rpx; font-weight: 700; color: #1A1A2E; }
.stat-box.win .stat-value { color: #22C97B; }
.stat-label { display: block; font-size: 20rpx; color: #B8B8C2; margin-top: 6rpx; }

/* NAVBAR */
.navbar {
  background: #FFFFFF;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  border-top: 1.5rpx solid #E6E6EB;
}
.nav-item { display: flex; flex-direction: column; align-items: center; padding: 8rpx 28rpx; }
.nav-item.active .nav-text { color: #1736C8; font-weight: 700; }
.nav-icon { font-size: 40rpx; margin-bottom: 6rpx; opacity: 0.5; }
.nav-item.active .nav-icon { opacity: 1; }
.nav-text { font-size: 22rpx; color: #B8B8C2; }
