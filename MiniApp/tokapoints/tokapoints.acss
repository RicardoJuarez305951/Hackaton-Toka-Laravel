page {
  background: #F5F6FA;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'Segoe UI', Roboto, sans-serif;
}
.container { padding-bottom: 120rpx; }

/* HEADER */
.header {
  background-color: #1736C8;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  padding: 56rpx 32rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.title-row { display: flex; align-items: center; }
.title { font-size: 44rpx; font-weight: 700; color: #FFFFFF; }
.balance {
  background: rgba(255,255,255,0.18);
  border-radius: 32rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 1.5rpx solid rgba(255,255,255,0.3);
}
.coin-icon { font-size: 30rpx; }
.balance-amount { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }

/* CURRENT BALANCE */
.current-balance {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  margin: 0 28rpx 28rpx;
  text-align: center;
  border: 1.5rpx solid #E6E6EB;
}
.balance-label { display: block; font-size: 26rpx; color: #4A4A4A; margin-bottom: 12rpx; font-weight: 600; }
.balance-value { display: block; font-size: 64rpx; font-weight: 800; color: #1736C8; }

/* PACKAGES */
.packages-section { padding: 0 28rpx; margin-bottom: 28rpx; }
.section-title {
  display: block;
  font-size: 22rpx;
  color: #B8B8C2;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
  font-weight: 600;
}
.packages-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.package-card {
  width: calc(50% - 8rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
  border: 1.5rpx solid #E6E6EB;
  position: relative;
  box-sizing: border-box;
}
.package-card:active { border-color: #1736C8; }
.package-icon { font-size: 48rpx; margin-bottom: 12rpx; }
.package-amount { display: block; font-size: 40rpx; font-weight: 800; color: #1736C8; margin-bottom: 4rpx; }
.package-name { display: block; font-size: 22rpx; color: #B8B8C2; margin-bottom: 12rpx; }
.package-cost { display: block; font-size: 28rpx; font-weight: 700; color: #1A1A2E; }
.badge {
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1736C8;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}
.badge.best { background: #22C97B; }

/* INFO SECTIONS - estilo historial de canjes */
.info-section { padding: 0 28rpx; margin-bottom: 28rpx; }
.info-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  border: 1.5rpx solid #E6E6EB;
}
.info-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E6E6EB;
}
.info-item:last-child { border-bottom: none; }
.info-icon { font-size: 32rpx; flex-shrink: 0; }
.info-text { flex: 1; }
.info-title { display: block; font-size: 26rpx; font-weight: 600; color: #1A1A2E; margin-bottom: 4rpx; }
.info-desc { display: block; font-size: 22rpx; color: #B8B8C2; }
.info-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #1736C8;
  background: rgba(23, 54, 200, 0.08);
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.info-tag-green {
  color: #22C97B;
  background: rgba(34, 201, 123, 0.1);
}
.info-tag-gold {
  color: #F5A623;
  background: rgba(245, 166, 35, 0.1);
}

/* NAVBAR */
.navbar {
  background: #FFFFFF;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  border-top: 1.5rpx solid #E6E6EB;
}
.nav-item { display: flex; flex-direction: column; align-items: center; padding: 8rpx 28rpx; }
.nav-item.active .nav-text { color: #1736C8; font-weight: 700; }
.nav-icon { font-size: 40rpx; margin-bottom: 6rpx; opacity: 0.5; }
.nav-item.active .nav-icon { opacity: 1; }
.nav-text { font-size: 22rpx; color: #B8B8C2; }
